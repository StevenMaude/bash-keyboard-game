{
  "name": "bash-keyboard-game",
  "version": "1.0.0",
  "description": "An educational game to learn bash keyboard edit shortcuts",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint js/ tests/ electron/",
    "build": "vite build",
    "build:electron": "vite build --mode electron",
    "preview": "vite preview",
    "dev": "vite",
    "electron": "electron .",
    "electron:dev": "concurrently -k -n vite,electron -c cyan,yellow \"vite\" \"wait-on tcp:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dist": "npm run build:electron && electron-builder"
  },
  "build": {
    "appId": "io.github.stevenmaude.bash-keyboard-game",
    "productName": "Bash Keyboard Game",
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "dist/renderer/**/*",
      "electron/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] }
      ],
      "category": "Education"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.0",
    "concurrently": "^9.1.2",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.0",
    "jsdom": "^24.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "wait-on": "^8.0.3"
  }
}
