{
  "name": "bash-keyboard-game",
  "version": "1.0.0",
  "description": "An educational Electron app to learn bash keyboard edit shortcuts",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "build": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "bash",
    "keyboard",
    "shortcuts",
    "educational",
    "game",
    "electron"
  ],
  "license": "MIT",
  "build": {
    "appId": "com.bashkeyboardgame.app",
    "productName": "Bash Keyboard Game",
    "files": [
      "main.js",
      "index.html",
      "css/**/*",
      "js/**/*"
    ],
    "linux": {
      "target": "dir"
    },
    "mac": {
      "target": "dir"
    },
    "win": {
      "target": "dir"
    }
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}
